{
	"$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
	"dest": "../../dist/ngx-editra",
	"lib": {
		"entryFile": "src/public-api.ts"
	},
	"assets": [
		{
			"glob": "**/*",
			"input": "src/styles",
			"output": "styles"
		},
		"README.md",
		"LICENSE",
		"docs",
		"PROGRESS.md",
		"CONTRIBUTING.md",
		"CHANGELOG.md"
	],
	"allowedNonPeerDependencies": ["prosemirror-.*", "parse5"]
}
